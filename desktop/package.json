{
  "name": "pagevault-desktop",
  "productName": "\u7f51\u9875\u6536\u85cf",
  "version": "1.5.10",
  "private": true,
  "description": "PageVault desktop (macOS/Windows/Linux) \u2014 wraps the sync server + reader in a real app window.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "arch=$(uname -m); [ \"$arch\" = \"x86_64\" ] && arch=x64; electron-packager . PageVault --platform=darwin --arch=$arch --out=dist --overwrite --extra-resource=../server"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-packager": "^17.1.2"
  }
}
