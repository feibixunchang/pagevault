<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/pvCard"
        android:paddingLeft="6dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/btn_icon_bg"
            android:contentDescription="@string/add_cancel"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="4dp"
            android:text="@string/settings_title"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 服务端 -->
            <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" style="@style/PvText" android:text="@string/settings_server" android:textStyle="bold" />
            <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" style="@style/PvTextMuted" android:layout_marginTop="2dp" android:text="@string/settings_server_tip" />
            <EditText
                android:id="@+id/serverInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_bg"
                android:hint="@string/settings_server_hint"
                android:inputType="textUri"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:singleLine="true"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?attr/pvMuted"
                android:textSize="14sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <Button android:id="@+id/btnSaveServer" style="@style/PvButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/add_saved" />
                <Button android:id="@+id/btnTest" style="@style/PvButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:layout_weight="1" android:text="@string/settings_test" />
            </LinearLayout>

            <!-- 外观 -->
            <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" style="@style/PvText" android:layout_marginTop="22dp" android:text="@string/settings_appearance" android:textStyle="bold" />
            <RadioGroup android:id="@+id/themeGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
                <RadioButton android:id="@+id/themeAuto" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/settings_theme_auto" android:textColor="?android:attr/textColorPrimary" android:textSize="14sp" />
                <RadioButton android:id="@+id/themeLight" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/settings_theme_light" android:textColor="?android:attr/textColorPrimary" android:textSize="14sp" />
                <RadioButton android:id="@+id/themeDark" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/settings_theme_dark" android:textColor="?android:attr/textColorPrimary" android:textSize="14sp" />
            </RadioGroup>

            <!-- 字号 -->
            <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" style="@style/PvText" android:layout_marginTop="22dp" android:text="@string/settings_fontsize" android:textStyle="bold" />
            <RadioGroup android:id="@+id/sizeGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
                <RadioButton android:id="@+id/sizeS" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="15" android:textColor="?android:attr/textColorPrimary" android:textSize="14sp" />
                <RadioButton android:id="@+id/sizeM" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="17" android:textColor="?android:attr/textColorPrimary" android:textSize="14sp" />
                <RadioButton android:id="@+id/sizeL" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="19.5" android:textColor="?android:attr/textColorPrimary" android:textSize="14sp" />
                <RadioButton android:id="@+id/sizeXL" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="22" android:textColor="?android:attr/textColorPrimary" android:textSize="14sp" />
                <RadioButton android:id="@+id/sizeXXL" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="24" android:textColor="?android:attr/textColorPrimary" android:textSize="14sp" />
            </RadioGroup>

            <!-- 粗体 / 只读正文 -->
            <CheckBox android:id="@+id/boldBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/settings_bold" android:textColor="?android:attr/textColorPrimary" android:textSize="15sp" />
            <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" style="@style/PvTextMuted" android:text="@string/settings_bold_tip" />
            <CheckBox android:id="@+id/readerBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/settings_reader" android:textColor="?android:attr/textColorPrimary" android:textSize="15sp" />
            <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" style="@style/PvTextMuted" android:text="@string/settings_reader_tip" />

            <!-- 字体 -->
            <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" style="@style/PvText" android:layout_marginTop="22dp" android:text="@string/settings_font" android:textStyle="bold" />
            <TextView android:id="@+id/fontState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" style="@style/PvTextMuted" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/fontTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" style="@style/PvTextMuted" android:layout_marginTop="4dp" android:textColor="?attr/pvAccentSoft" android:visibility="gone" />
            <Button android:id="@+id/btnFont" style="@style/PvButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/settings_font" />

            <TextView android:id="@+id/versionLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" style="@style/PvTextMuted" android:layout_marginTop="26dp" android:layout_marginBottom="12dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
